OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
# Optional. Scene name switched to when the standby countdown reaches zero
# (standby.html can also pass ?obsScene= per page).
OBS_DEFAULT_SCENE=

# AMLL playback broadcast (NetEase now-playing, AMLL WebSocket protocol V2)
# Requires the AMLL broadcast enabled in the NetEase client (default port 11444).
NCM_ENABLED=true
# auto: AMLL preferred, native Windows SMTC fallback; amll / smtc: force one source
NCM_SOURCE=auto
# Match NetEase only; do not capture browsers or unrelated music players
NCM_SMTC_APP_PATTERN=cloudmusic|netease|网易云
NCM_SMTC_INTERVAL_MS=1000
AMLL_WS_URL=ws://127.0.0.1:11444

# Optional. Receiving ordinary live danmaku supports anonymous mode.
# Set the full Cookie only when a logged-in Bilibili session is required.
BILIBILI_COOKIE=
BILIBILI_SESSDATA=
BILIBILI_UID=
BILIBILI_BUVID=
BILIBILI_ROOM_ID=30068664
BILIBILI_OWNER_UID=
BILIBILI_ADMIN_UIDS=

# Danmaku-Frame network. Keep HOST on loopback unless remote access is required.
HOST=127.0.0.1
PORT=7788
WS_PORT=7789
WS_AUTH_TOKEN=
WS_MAX_MESSAGE_BYTES=16384

# Song request MVP. Put legal local audio files in danmaku-frame/music.
SONG_REQUEST_ENABLED=true
SONG_MUSIC_DIR=music
SONG_STATE_FILE=data/song-state.json
SONG_MAX_QUEUE_LENGTH=50
SONG_MAX_PER_USER=2
SONG_COOLDOWN_SECONDS=30
SONG_MAX_DURATION_SECONDS=600
SONG_ALLOW_DIRECT_URLS=false
SONG_LEGACY_MEDIA_KEYS=false
SONG_BLOCKED_UIDS=
SONG_ALLOWED_UIDS=
SONG_BLOCKED_KEYWORDS=

# Danmaku reading (Edge TTS / MIMO TTS hybrid synthesis + Windows local playback)
# Master switch. 主播/房管可用弹幕命令“朗读开/朗读关”实时切换。
TTS_ENABLED=false
# Engine: edge / mimo / hybrid (粉丝牌/白名单->MIMO) / fish (Fish Audio cloud)
TTS_PROVIDER=hybrid
# Fish Audio official cloud API. Keep keys in OBS/.env (server only).
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
# Optional: use the Windows system proxy automatically, or set a proxy URL / "direct" here.
FISH_AUDIO_PROXY_URL=
FISH_AUDIO_MODEL=s2.1-pro
# 32-character hexadecimal voice reference ID from fish.audio
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_TIMEOUT_MS=30000
# Edge 音色: zh-CN-XiaoxiaoNeural (晓晓), zh-CN-YunxiNeural (云希), zh-CN-YunyangNeural (云扬) ...
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%
# Speaker volume 0-100 (local output only)
TTS_PLAYER_VOLUME=100
TTS_MAX_TEXT_LENGTH=60
TTS_SKIP_COMMANDS=true
TTS_BLOCKED_UIDS=
TTS_BLOCKED_KEYWORDS=
TTS_DEDUPE_SECONDS=10
TTS_COOLDOWN_SECONDS=3
TTS_AUDIO_FILE=data/tts/current.mp3
# Runtime switch persistence (弹幕「朗读开/关」与 HTTP 开关跨重启保留)
TTS_STATE_FILE=data/tts-state.json

# Crash auto-restart watchdog (supervisor.mjs)
# Runtime switch also writable via POST /api/auto-restart or data/auto-restart.json
AUTO_RESTART_ENABLED=true
AUTO_RESTART_SWITCH_FILE=data/auto-restart.json
TTS_VOICE_GUARD=zh-CN-YunyangNeural
TTS_VOICE_TIERS=21-40:zh-CN-YunjianNeural,11-20:zh-CN-YunxiNeural,1-10:zh-CN-XiaoyiNeural
# 用户级音色预设（最高优先级）：用户名:音色 或 uid:音色，逗号分隔
TTS_VOICE_USERS=人境庐丶:zh-CN-XiaoxiaoNeural
# MIMO 通道白名单：无法挂自己粉丝牌的主播/UID，可授权注册音色设计并走 MIMO 引擎
TTS_MIMO_UIDS=
# 音色设计注册（弹幕指令「注册音色 <描述>」绑定 UID → MIMO voicedesign 模型）
TTS_VOICE_DESIGN_ENABLED=true
TTS_VOICE_DESIGN_PROMPT_MAX=120
TTS_VOICE_DESIGN_COOLDOWN_SECONDS=60
TTS_VOICE_DESIGN_MAX_USERS=500
# 粉丝牌/舰长用户朗读时不加用户名/舰长前缀（只读正文）
TTS_NO_PREFIX_FOR_MEDAL_GUARD=false

# 外挂 LLM（商汤日日新 SenseNova，OpenAI 兼容）：音色设计提示词细化
# 把观众的抽象描述（如"派大星""萝莉音"）扩写成 MiMo voicedesign 可用的多维度音色描述；
# 未配置或调用失败时回退直存观众原文。
SENSENOVA_API_KEY=
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.8-flash-lite
LLM_TIMEOUT_MS=8000
LLM_VOICE_REFINE=true

# Parallel Fish/MIMO synthesis; playback remains ordered. Edge is limited to one request.
TTS_SYNTH_CONCURRENCY=3

# Block Fish voice IDs globally (comma separated); users may still choose other voices.
TTS_FISH_BLOCKED_VOICES=
